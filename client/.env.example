# ==========================================
# CRICKETVERSE - CLIENT ENVIRONMENT CONFIG
# ==========================================

# Public URL of the frontend (used for generating shareable invitation links for WhatsApp / external friends)
# Example for local development with LAN access: http://192.168.1.15:5173
# Example for public deployment: https://cricketverse.app or https://your-app.vercel.app
VITE_APP_URL=http://localhost:5173

# Public URL of the backend API
# Example for local development with LAN access: http://192.168.1.15:5001/api
# Example for public deployment: https://api.cricketverse.app/api or https://your-backend.onrender.com/api
# Leave empty to automatically use relative /api in production or http://<host>:5001/api in dev
VITE_API_URL=

# Public URL for Socket.IO multiplayer connection
# Example for public deployment: https://api.cricketverse.app or https://your-backend.onrender.com
# Leave empty to automatically match VITE_API_URL or current host in dev
VITE_SOCKET_URL=

