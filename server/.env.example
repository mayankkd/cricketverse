# ==========================================
# CRICKETVERSE - SERVER ENVIRONMENT CONFIG
# ==========================================

PORT=5001
NODE_ENV=development

# Allowed Frontend URL(s) for CORS & link generation
CLIENT_URL=https://cricketverse-gold.vercel.app
FRONTEND_URL=https://cricketverse-gold.vercel.app

# Database (Remote MongoDB Atlas or local URI; falls back seamlessly to in-memory store if mongod is offline)
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cricketverse?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cricketverse

# Security & Authentication
JWT_SECRET=cricketverse_ultra_secure_jwt_secret_token_2026_ipl_fut_champions
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_ENABLED=true
